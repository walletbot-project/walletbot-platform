---
import '@fontsource-variable/inter'
import { getAbsoluteLocaleUrl } from 'astro:i18n'
import SiteFooter from '@/components/site-footer.astro'
import SiteHeader from '@/components/site-header.astro'
import { DEFAULT_LOCALE, LOCALES, useTranslations } from '@/i18n'
import '@/styles/global.css'

type Props = {
    /** Full `<title>`. Defaults to the catalog's `meta.title`. */
    title?: string
    description?: string
}

const { locale, t } = useTranslations(Astro.currentLocale)
const { title = t.meta.title, description = t.meta.description } = Astro.props

// Every route lives under `/<locale>/`, so dropping the first segment leaves the
// path the other locales need appended to their own prefix.
const path = Astro.url.pathname.split('/').filter(Boolean).slice(1).join('/')
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/favicon.png" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={getAbsoluteLocaleUrl(locale, path)} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={getAbsoluteLocaleUrl(locale, path)} />

        {/* Tells crawlers the two locales are translations of one page. */}
        {
            LOCALES.map((alternate) => (
                <link
                    rel="alternate"
                    hreflang={alternate}
                    href={getAbsoluteLocaleUrl(alternate, path)}
                />
            ))
        }
        <link
            rel="alternate"
            hreflang="x-default"
            href={getAbsoluteLocaleUrl(DEFAULT_LOCALE, path)}
        />

        <meta name="theme-color" content="#020617" />
        <meta name="generator" content={Astro.generator} />
    </head>

    <body
        class="flex min-h-dvh flex-col bg-slate-950 text-slate-100 antialiased"
    >
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:text-slate-950"
        >
            {t.nav.skipToContent}
        </a>

        <SiteHeader />

        <main id="main" class="flex-1">
            <slot />
        </main>

        <SiteFooter />
    </body>
</html>
