---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n'
import {
    DEFAULT_LOCALE,
    LOCALE_LABELS,
    LOCALES,
    useTranslations,
} from '@/i18n'
import '@/styles/global.css'

type Props = {
    /** Full `<title>`. Defaults to the catalog's `meta.title`. */
    title?: string
    description?: string
}

const { locale, t } = useTranslations(Astro.currentLocale)
const { title = t.meta.title, description = t.meta.description } = Astro.props

// Every route lives under `/<locale>/`, so dropping the first segment leaves the
// path the other locales need appended to their own prefix.
const path = Astro.url.pathname.split('/').filter(Boolean).slice(1).join('/')
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/favicon.png" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={getAbsoluteLocaleUrl(locale, path)} />

        {/* Tells crawlers the two locales are translations of one page. */}
        {
            LOCALES.map((alternate) => (
                <link
                    rel="alternate"
                    hreflang={alternate}
                    href={getAbsoluteLocaleUrl(alternate, path)}
                />
            ))
        }
        <link
            rel="alternate"
            hreflang="x-default"
            href={getAbsoluteLocaleUrl(DEFAULT_LOCALE, path)}
        />

        <meta name="generator" content={Astro.generator} />
    </head>

    <body class="min-h-dvh bg-white text-slate-900 antialiased">
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:rounded focus:bg-slate-900 focus:px-3 focus:py-2 focus:text-white"
        >
            {t.nav.skipToContent}
        </a>

        <header class="flex justify-end p-6">
            <nav aria-label={t.nav.languageLabel} class="flex gap-3 text-sm">
                {
                    LOCALES.map((alternate) => (
                        <a
                            href={getRelativeLocaleUrl(alternate, path)}
                            hreflang={alternate}
                            aria-current={alternate === locale
                                ? 'page'
                                : undefined}
                            class:list={[
                                'underline-offset-4 hover:underline',
                                alternate === locale
                                    ? 'font-semibold'
                                    : 'text-slate-500',
                            ]}
                        >
                            {LOCALE_LABELS[alternate]}
                        </a>
                    ))
                }
            </nav>
        </header>

        <main id="main" class="px-6 pb-16">
            <slot />
        </main>
    </body>
</html>
