---
import { useTranslations } from '@/i18n'
import Icon from './icon.astro'

/**
 * CSS-only stylized illustration of the native voice screen: live status,
 * the user's utterance, and the editable action card the assistant creates.
 * Purely decorative — the copy lives in the `demo` catalog section.
 */
const { t } = useTranslations(Astro.currentLocale)

// Static waveform bar heights (px) with staggered pulse delays.
const WAVE = [10, 18, 26, 14, 22, 8]
---

<div
    class="relative mx-auto w-[280px] motion-safe:animate-[float_7s_ease-in-out_infinite] sm:w-[310px]"
>
    {/* Glow behind the device. */}
    <div
        class="absolute -inset-10 rounded-full bg-brand/20 blur-3xl"
        aria-hidden="true"
    >
    </div>

    <div
        class="relative rounded-[2.5rem] border border-line-strong bg-panel p-3 shadow-2xl ring-1 ring-line"
    >
        <div class="space-y-4 rounded-[2rem] bg-surface px-4 pt-4 pb-5">
            <div class="mx-auto h-1.5 w-16 rounded-full bg-line" aria-hidden="true">
            </div>

            <div
                class="flex items-center justify-between text-[11px] font-medium text-ink-soft"
            >
                <span class="flex items-center gap-1.5">
                    <span class="relative flex size-2" aria-hidden="true">
                        <span
                            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand opacity-75"
                        >
                        </span>
                        <span
                            class="relative inline-flex size-2 rounded-full bg-brand"
                        >
                        </span>
                    </span>
                    {t.demo.listening}
                </span>

                <span class="flex items-end gap-[3px]" aria-hidden="true">
                    {
                        WAVE.map((height, index) => (
                            <span
                                class="w-[3px] animate-pulse rounded-full bg-brand/80"
                                style={`height:${height}px;animation-delay:${index * 120}ms`}
                            />
                        ))
                    }
                </span>
            </div>

            <div
                class="ml-auto max-w-[85%] rounded-2xl rounded-br-sm border border-brand/20 bg-brand/10 px-3.5 py-2.5 text-[13px] leading-snug text-ink"
            >
                {t.demo.userSays}
            </div>

            <div class="rounded-xl border border-line bg-panel-alt p-3.5">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p
                            class="text-[10px] font-medium tracking-widest text-ink-soft uppercase"
                        >
                            {t.demo.actionType}
                        </p>
                        <p class="mt-1 text-sm font-medium text-ink">
                            {t.demo.actionName}
                        </p>
                        <p class="text-[11px] text-ink-soft">
                            {t.demo.actionAccount}
                        </p>
                    </div>
                    <p class="text-lg font-semibold tracking-tight text-ink">
                        {t.demo.actionAmount}
                    </p>
                </div>
                <p
                    class="mt-3 flex items-center gap-1.5 border-t border-line pt-2.5 text-[11px] text-ink-soft"
                >
                    <Icon name="check" class="size-3.5 shrink-0 text-brand-ink" />
                    {t.demo.logged}
                </p>
            </div>

            <div class="flex justify-center pt-1">
                <div
                    class="flex size-12 items-center justify-center rounded-full bg-brand/15 ring-1 ring-brand/40"
                >
                    <Icon name="mic" class="size-5 text-brand-ink" />
                </div>
            </div>
        </div>
    </div>
</div>
