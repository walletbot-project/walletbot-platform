---
import Icon from '@/components/icon.astro'
import PhoneMockup from '@/components/phone-mockup.astro'
import StoreBadges from '@/components/store-badges.astro'
import { LOCALE_LABELS, useTranslations } from '@/i18n'
import BaseLayout from '@/layouts/base-layout.astro'

const { t } = useTranslations(Astro.currentLocale)

const voiceTypes = Object.values(t.features.items.voice.types)
const stats = Object.values(t.stats)

// Decorative bar heights (%) for the dashboard card's mini chart.
const CHART_BARS = [45, 70, 35, 85, 55, 75, 40]

const card =
    'rounded-2xl border border-white/10 bg-white/5 p-6 transition-all hover:-translate-y-1 hover:border-white/20 hover:bg-white/[0.07] hover:shadow-[0_12px_40px_rgb(109_231_216/0.07)]'
const iconChip =
    'flex size-10 items-center justify-center rounded-lg bg-brand/15 ring-1 ring-brand/25'
---

<BaseLayout>
    {/* ── Hero ─────────────────────────────────────────────────────────── */}
    <section class="relative overflow-hidden">
        {/* Faded grid + ambient glows. */}
        <div
            class="absolute inset-0 -z-20 bg-[linear-gradient(to_right,rgb(255_255_255/0.045)_1px,transparent_1px),linear-gradient(to_bottom,rgb(255_255_255/0.045)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_75%_65%_at_50%_0%,black,transparent)]"
            aria-hidden="true"
        >
        </div>
        <div
            class="pointer-events-none absolute -top-40 left-1/2 -z-10 size-[42rem] -translate-x-1/2 rounded-full bg-brand/15 blur-3xl"
            aria-hidden="true"
        >
        </div>
        <div
            class="pointer-events-none absolute top-40 -right-40 -z-10 size-[30rem] rounded-full bg-teal-500/10 blur-3xl"
            aria-hidden="true"
        >
        </div>

        <div
            class="mx-auto grid w-full max-w-6xl items-center gap-16 px-6 pt-16 pb-24 sm:pt-24 lg:grid-cols-[1.1fr_0.9fr] lg:gap-8 lg:pt-28 lg:pb-32"
        >
            <div
                class="flex flex-col items-center gap-7 text-center lg:items-start lg:text-left"
            >
                <p
                    class="flex items-center gap-2 rounded-full border border-brand/30 bg-brand/10 px-3.5 py-1.5 text-xs font-medium text-slate-200 shadow-[0_0_20px_rgb(109_231_216/0.15)]"
                >
                    <Icon name="mic" class="size-3.5 text-brand" />
                    {t.hero.badge}
                </p>

                <h1
                    class="max-w-2xl bg-gradient-to-b from-white via-white to-slate-400 bg-clip-text text-5xl font-semibold tracking-tighter text-balance text-transparent sm:text-7xl lg:text-8xl"
                >
                    {t.hero.headline}
                </h1>

                <p class="max-w-xl text-lg text-pretty text-slate-400 sm:text-xl">
                    {t.hero.subheadline}
                </p>

                <StoreBadges />

                <a
                    href="#features"
                    class="group text-sm text-slate-400 transition-colors hover:text-white"
                >
                    {t.hero.ctaFeatures}
                    <span
                        aria-hidden="true"
                        class="inline-block transition-transform group-hover:translate-y-0.5"
                    >
                        ↓
                    </span>
                </a>
            </div>

            <PhoneMockup />
        </div>

        {/* Stats strip. */}
        <div class="border-t border-white/10 bg-white/[0.02]">
            <dl
                class="mx-auto grid w-full max-w-6xl grid-cols-2 gap-x-6 gap-y-8 px-6 py-10 text-center lg:grid-cols-4"
            >
                {
                    stats.map((stat) => (
                        <div>
                            <dd
                                class="text-4xl font-semibold tracking-tight text-white sm:text-5xl"
                            >
                                {stat.value}
                            </dd>
                            <dt
                                class="mt-2 text-xs font-medium tracking-widest text-slate-500 uppercase"
                            >
                                {stat.label}
                            </dt>
                        </div>
                    ))
                }
            </dl>
        </div>
    </section>

    {/* ── Features (bento) ─────────────────────────────────────────────── */}
    <section
        id="features"
        class="scroll-mt-20 border-t border-white/10"
    >
        <div class="mx-auto w-full max-w-6xl px-6 py-20 lg:py-28">
            <h2
                class="text-3xl font-semibold tracking-tight text-white sm:text-5xl"
            >
                {t.features.title}
            </h2>
            <p class="mt-4 max-w-xl text-lg text-slate-400">
                {t.features.subtitle}
            </p>

            <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {/* Voice — flagship, double width. */}
                <div class:list={[card, 'sm:col-span-2']}>
                    <div class={iconChip}>
                        <Icon name="mic" class="size-5 text-brand" />
                    </div>
                    <h3 class="mt-4 font-medium text-white">
                        {t.features.items.voice.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-400">
                        {t.features.items.voice.body}
                    </p>
                    <ul class="mt-4 flex flex-wrap gap-2">
                        {
                            voiceTypes.map((type) => (
                                <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-300">
                                    {type}
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class={card}>
                    <div class={iconChip}>
                        <Icon name="cloud-off" class="size-5 text-brand" />
                    </div>
                    <h3 class="mt-4 font-medium text-white">
                        {t.features.items.offline.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-400">
                        {t.features.items.offline.body}
                    </p>
                </div>

                <div class={card}>
                    <div class={iconChip}>
                        <Icon name="lock" class="size-5 text-brand" />
                    </div>
                    <h3 class="mt-4 font-medium text-white">
                        {t.features.items.local.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-400">
                        {t.features.items.local.body}
                    </p>
                </div>

                <div class={card}>
                    <div class={iconChip}>
                        <Icon name="zap" class="size-5 text-brand" />
                    </div>
                    <h3 class="mt-4 font-medium text-white">
                        {t.features.items.fast.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-400">
                        {t.features.items.fast.body}
                    </p>
                </div>

                <div class={card}>
                    <div class={iconChip}>
                        <Icon name="coins" class="size-5 text-brand" />
                    </div>
                    <h3 class="mt-4 font-medium text-white">
                        {t.features.items.currencies.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-400">
                        {t.features.items.currencies.body}
                    </p>
                </div>

                {/* Dashboard — double width with a decorative mini chart. */}
                <div class:list={[card, 'sm:col-span-2']}>
                    <div class="flex flex-wrap items-start justify-between gap-6">
                        <div class="max-w-sm">
                            <div class={iconChip}>
                                <Icon
                                    name="layout-dashboard"
                                    class="size-5 text-brand"
                                />
                            </div>
                            <h3 class="mt-4 font-medium text-white">
                                {t.features.items.dashboard.title}
                            </h3>
                            <p
                                class="mt-2 text-sm leading-relaxed text-slate-400"
                            >
                                {t.features.items.dashboard.body}
                            </p>
                        </div>

                        <div
                            class="flex h-24 min-w-40 flex-1 items-end gap-2 self-end border-b border-white/10 pb-px"
                            aria-hidden="true"
                        >
                            {
                                CHART_BARS.map((height) => (
                                    <div
                                        class="flex-1 rounded-t bg-brand/50"
                                        style={`height:${height}%`}
                                    />
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div class={card}>
                    <div class={iconChip}>
                        <Icon name="filter" class="size-5 text-brand" />
                    </div>
                    <h3 class="mt-4 font-medium text-white">
                        {t.features.items.filters.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-400">
                        {t.features.items.filters.body}
                    </p>
                </div>

                {/* Bilingual — full-width slim banner. */}
                <div
                    class:list={[
                        card,
                        'flex flex-wrap items-center justify-between gap-6 sm:col-span-2 lg:col-span-3',
                    ]}
                >
                    <div class="flex items-start gap-4">
                        <div class:list={[iconChip, 'shrink-0']}>
                            <Icon name="globe" class="size-5 text-brand" />
                        </div>
                        <div class="max-w-xl">
                            <h3 class="font-medium text-white">
                                {t.features.items.bilingual.title}
                            </h3>
                            <p
                                class="mt-1 text-sm leading-relaxed text-slate-400"
                            >
                                {t.features.items.bilingual.body}
                            </p>
                        </div>
                    </div>

                    <p
                        class="flex items-center gap-2 text-sm font-medium text-slate-300"
                        aria-hidden="true"
                    >
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-3 py-1"
                        >
                            {LOCALE_LABELS.es}
                        </span>
                        ⇄
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-3 py-1"
                        >
                            {LOCALE_LABELS.en}
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </section>

    {/* ── Download CTA ─────────────────────────────────────────────────── */}
    <section
        id="download"
        class="relative scroll-mt-20 overflow-hidden border-t border-white/10"
    >
        <div
            class="pointer-events-none absolute -bottom-52 left-1/2 -z-10 size-[36rem] -translate-x-1/2 rounded-full bg-brand/15 blur-3xl"
            aria-hidden="true"
        >
        </div>

        <div
            class="mx-auto flex w-full max-w-3xl flex-col items-center gap-8 px-6 py-24 text-center lg:py-32"
        >
            <h2
                class="bg-gradient-to-b from-white via-white to-slate-400 bg-clip-text text-4xl font-semibold tracking-tighter text-transparent sm:text-6xl"
            >
                {t.download.title}
            </h2>
            <p class="text-lg text-slate-400 sm:text-xl">
                {t.download.subtitle}
            </p>

            <StoreBadges variant="cta" />
        </div>
    </section>
</BaseLayout>
