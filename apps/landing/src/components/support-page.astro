---
import { getRelativeLocaleUrl } from 'astro:i18n'
import Icon from '@/components/icon.astro'
import { useTranslations } from '@/i18n'
import BaseLayout from '@/layouts/base-layout.astro'

/**
 * Support page: one mailbox and nothing else. Nothing on this site posts
 * anywhere (see README § Getting the app), so support is an email address, not
 * a form. The address itself is localized (`support@` in English,
 * `soporte@` in Spanish, same inbox), matching `feedback.supportEmail` in
 * apps/web and `feedbackSupportEmail` in the native app.
 */
const { locale, t } = useTranslations(Astro.currentLocale)

// The subject arrives prefilled, as it does from the app's support dialog, so
// the inbox can tell app mail from everything else the domain receives.
const mailto = `mailto:${t.support.email}?subject=${encodeURIComponent(t.support.emailSubject)}`
---

<BaseLayout title={t.support.meta.title} description={t.support.meta.description}>
    <section class="relative overflow-hidden">
        <div
            class="pointer-events-none absolute -top-40 left-1/2 -z-10 size-[36rem] -translate-x-1/2 rounded-full bg-brand/15 blur-3xl"
            aria-hidden="true"
        >
        </div>

        <div
            class="mx-auto flex w-full max-w-2xl flex-col items-center gap-7 px-6 py-20 text-center lg:py-28"
        >
            <h1
                class="bg-gradient-to-b from-white via-white to-slate-400 bg-clip-text text-4xl font-semibold tracking-tighter text-balance text-transparent sm:text-6xl"
            >
                {t.support.heading}
            </h1>

            <p class="text-lg text-balance text-slate-400">{t.support.body}</p>

            <a
                href={mailto}
                class="group flex w-full items-center gap-5 rounded-2xl border border-white/10 bg-white/[0.03] px-6 py-7 text-left transition-colors hover:border-brand/40 hover:bg-white/[0.06] sm:px-8"
            >
                <span
                    class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-brand/10 ring-1 ring-brand/25"
                >
                    <Icon name="mail" class="size-6 text-brand" />
                </span>

                <span class="flex-1">
                    <span class="block text-xs font-medium text-slate-400">
                        {t.support.emailLabel}
                    </span>
                    {/* `break-all`: the address is longer than a narrow phone
                        viewport and has nowhere natural to wrap. */}
                    <span
                        class="mt-1 block text-lg font-semibold break-all text-white sm:text-xl"
                    >
                        {t.support.email}
                    </span>
                </span>

                <Icon
                    name="arrow-right"
                    class="size-5 shrink-0 text-slate-500 transition-all group-hover:translate-x-1 group-hover:text-white"
                />
            </a>

            <a
                href={getRelativeLocaleUrl(locale)}
                class="text-sm text-slate-500 underline-offset-4 hover:text-white hover:underline"
            >
                ← {t.support.backHome}
            </a>
        </div>
    </section>
</BaseLayout>
