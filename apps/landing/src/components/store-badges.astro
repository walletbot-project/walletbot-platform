---
import { useTranslations } from '@/i18n'
import { PLAY_STORE_URL } from '@/lib/links'
import Icon from './icon.astro'

/**
 * Two-line store badges: Google Play linked, App Store coming soon. The
 * primary conversion element — shown in the hero and again, larger, in the
 * closing download section.
 */
type Props = {
    /** `hero`: left-aligned on desktop. `cta`: centered and larger. */
    variant?: 'hero' | 'cta'
}

const { variant = 'hero' } = Astro.props
const large = variant === 'cta'

const { t } = useTranslations(Astro.currentLocale)
---

<div
    class:list={[
        'flex flex-wrap items-center justify-center gap-3',
        variant === 'hero' && 'lg:justify-start',
        large && 'gap-4',
    ]}
>
    <a
        href={PLAY_STORE_URL}
        class:list={[
            'group flex items-center rounded-xl border border-brand/40 bg-brand/10 transition-all hover:-translate-y-0.5 hover:border-brand/70 hover:bg-brand/15 hover:shadow-[0_8px_30px_rgb(109_231_216/0.25)]',
            large ? 'gap-4 rounded-2xl px-7 py-4' : 'gap-3 px-4 py-2.5',
        ]}
    >
        <Icon
            name="google-play"
            class:list={['text-white', large ? 'size-8' : 'size-6']}
        />
        <span class="text-left">
            <span
                class:list={[
                    'block tracking-wide text-slate-300 uppercase',
                    large ? 'text-[11px]' : 'text-[10px]',
                ]}
            >
                {t.download.android.lead}
            </span>
            <span
                class:list={[
                    'block leading-tight font-semibold text-white',
                    large ? 'text-lg' : 'text-sm',
                ]}
            >
                {t.download.android.name}
            </span>
        </span>
    </a>

    <div
        class:list={[
            'flex cursor-default items-center rounded-xl border border-white/10 border-dashed bg-white/[0.02] opacity-70',
            large ? 'gap-4 rounded-2xl px-7 py-4' : 'gap-3 px-4 py-2.5',
        ]}
    >
        <Icon
            name="apple"
            class:list={['text-slate-400', large ? 'size-8' : 'size-6']}
        />
        <span class="text-left">
            <span
                class:list={[
                    'block tracking-wide text-slate-500 uppercase',
                    large ? 'text-[11px]' : 'text-[10px]',
                ]}
            >
                {t.download.ios.lead}
            </span>
            <span
                class:list={[
                    'block leading-tight font-semibold text-slate-300',
                    large ? 'text-lg' : 'text-sm',
                ]}
            >
                {t.download.ios.name}
            </span>
        </span>
    </div>
</div>
