---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { useTranslations } from '@/i18n'
import { WEB_APP_URL } from '@/lib/links'
import Icon from './icon.astro'

/**
 * The three ways to get Wallet Bot, side by side. Shown in the hero and again,
 * larger, in the closing download section.
 *
 * Both store badges route to the beta form rather than a store. The two
 * listings are public, but the form is the way in, and its confirmation
 * message carries the store links (src/lib/links.ts). The web app is the only
 * one that skips the form, so it links straight out, leads and carries the
 * brand fill. The two stores follow, muted and identical.
 */
type Props = {
    /** `hero`: left-aligned on desktop. `cta`: centered and larger. */
    variant?: 'hero' | 'cta'
}

const { variant = 'hero' } = Astro.props
const large = variant === 'cta'

const { locale, t } = useTranslations(Astro.currentLocale)

const beta = getRelativeLocaleUrl(locale, 'beta')

const badges = [
    {
        href: WEB_APP_URL,
        icon: 'monitor',
        copy: t.download.web,
        tone: 'border-brand-line bg-brand hover:brightness-105 hover:shadow-[0_8px_30px_rgb(109_231_216/0.45)]',
        iconTone: 'text-brand-on',
        leadTone: 'text-brand-on/80',
        nameTone: 'text-brand-on',
    },
    {
        href: beta,
        icon: 'google-play',
        copy: t.download.android,
        tone: 'border-line-strong bg-panel hover:border-brand-line hover:bg-brand-tint',
        iconTone: 'text-ink',
        leadTone: 'text-ink-soft',
        nameTone: 'text-ink',
    },
    {
        href: beta,
        icon: 'apple',
        copy: t.download.ios,
        tone: 'border-line-strong bg-panel hover:border-brand-line hover:bg-brand-tint',
        iconTone: 'text-ink',
        leadTone: 'text-ink-soft',
        nameTone: 'text-ink',
    },
] as const
---

<div
    class:list={[
        'grid w-full gap-3 sm:grid-cols-3',
        large ? 'max-w-3xl gap-4' : 'max-w-xl',
    ]}
>
    {
        badges.map((badge) => (
            <a
                href={badge.href}
                class:list={[
                    'group flex items-center border transition-all hover:-translate-y-0.5',
                    large
                        ? 'gap-4 rounded-2xl px-7 py-4'
                        : 'gap-3 rounded-xl px-4 py-2.5',
                    badge.tone,
                ]}
            >
                <Icon
                    name={badge.icon}
                    class:list={[
                        'shrink-0',
                        badge.iconTone,
                        large ? 'size-8' : 'size-6',
                    ]}
                />
                <span class="text-left">
                    <span
                        class:list={[
                            'block tracking-wide uppercase',
                            badge.leadTone,
                            large ? 'text-[11px]' : 'text-[10px]',
                        ]}
                    >
                        {badge.copy.lead}
                    </span>
                    <span
                        class:list={[
                            'block leading-tight font-semibold',
                            badge.nameTone,
                            large ? 'text-lg' : 'text-sm',
                        ]}
                    >
                        {badge.copy.name}
                    </span>
                </span>
            </a>
        ))
    }
</div>
