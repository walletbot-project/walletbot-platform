---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { useTranslations } from '@/i18n'

const { locale, t } = useTranslations(Astro.currentLocale)

// Baked in at build time — the site rebuilds on every deploy.
const year = new Date().getFullYear()
---

<footer class="border-t border-line">
    <div
        class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between"
    >
        <div class="space-y-1">
            <p class="font-semibold tracking-tight text-ink">Wallet Bot</p>
            <p class="text-sm text-ink-soft">{t.footer.tagline}</p>
        </div>

        <div class="flex flex-col gap-2 text-sm sm:items-end">
            <nav class="flex flex-wrap gap-x-5 gap-y-2">
                <a
                    href={getRelativeLocaleUrl(locale, 'support')}
                    class="text-ink-soft underline-offset-4 hover:text-ink hover:underline"
                >
                    {t.footer.support}
                </a>
                <a
                    href={getRelativeLocaleUrl(locale, 'privacy')}
                    class="text-ink-soft underline-offset-4 hover:text-ink hover:underline"
                >
                    {t.footer.privacy}
                </a>
                <a
                    href={getRelativeLocaleUrl(locale, 'terms')}
                    class="text-ink-soft underline-offset-4 hover:text-ink hover:underline"
                >
                    {t.footer.terms}
                </a>
            </nav>
            <p class="text-ink-soft">{t.footer.copyright({ year })}</p>
        </div>
    </div>
</footer>
