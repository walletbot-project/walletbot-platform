---
import { getRelativeLocaleUrl } from 'astro:i18n'
import Icon from '@/components/icon.astro'
import { useTranslations } from '@/i18n'
import BaseLayout from '@/layouts/base-layout.astro'
import { BETA_FORM_URL, WEB_APP_URL } from '@/lib/links'

/**
 * Where both store badges land. The signup itself is a Google Form, so the
 * hero holds one filled card and nothing that competes with it. The web app
 * gets its own quieter section further down, for readers who don't want to
 * wait for a tester slot.
 */
const { locale, t } = useTranslations(Astro.currentLocale)
---

<BaseLayout title={t.beta.meta.title} description={t.beta.meta.description}>
    <section class="relative overflow-hidden">
        <div
            class="pointer-events-none absolute -top-40 left-1/2 -z-10 size-[36rem] -translate-x-1/2 rounded-full bg-brand/15 blur-3xl"
            aria-hidden="true"
        >
        </div>

        <div
            class="mx-auto flex w-full max-w-2xl flex-col items-center gap-7 px-6 py-20 text-center lg:py-28"
        >
            {/* One pill per platform, tinted the same way as their badges on
                the home page. */}
            <div class="flex flex-wrap items-center justify-center gap-2.5">
                <p
                    class="flex items-center gap-2 rounded-full border border-brand/30 bg-brand/10 px-3.5 py-1.5 text-xs font-medium text-slate-200"
                >
                    <Icon name="google-play" class="size-3.5 text-brand" />
                    {t.beta.chip.android}
                </p>
                <p
                    class="flex items-center gap-2 rounded-full border border-white/10 border-dashed bg-white/[0.02] px-3.5 py-1.5 text-xs font-medium text-slate-400"
                >
                    <Icon name="apple" class="size-3.5 text-slate-500" />
                    {t.beta.chip.ios}
                </p>
            </div>

            <h1
                class="bg-gradient-to-b from-white via-white to-slate-400 bg-clip-text text-4xl font-semibold tracking-tighter text-balance text-transparent sm:text-6xl"
            >
                {t.beta.heading}
            </h1>

            <p class="text-lg text-balance text-slate-400">{t.beta.body}</p>

            {/* The card and its iOS note read as one unit, hence the tighter
                gap than the section's. */}
            <div class="flex w-full flex-col gap-4">
                <a
                    href={BETA_FORM_URL}
                    class="group flex w-full items-center gap-5 rounded-2xl bg-brand px-6 py-7 text-left shadow-[0_18px_50px_-12px_rgb(109_231_216/0.45)] ring-1 ring-brand/60 transition-all hover:-translate-y-0.5 hover:brightness-105 hover:shadow-[0_24px_60px_-10px_rgb(109_231_216/0.6)] sm:px-8"
                >
                    <span
                        class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-slate-950/10 ring-1 ring-slate-950/10"
                    >
                        <Icon
                            name="clipboard-list"
                            class="size-6 text-slate-950"
                        />
                    </span>

                    <span class="flex-1">
                        <span class="block text-lg font-semibold text-slate-950">
                            {t.beta.formCta.title}
                        </span>
                        <span class="mt-1 block text-sm text-slate-900/70">
                            {t.beta.formCta.body}
                        </span>
                    </span>

                    <Icon
                        name="arrow-right"
                        class="size-5 shrink-0 text-slate-950/60 transition-all group-hover:translate-x-1 group-hover:text-slate-950"
                    />
                </a>

                <p
                    class="flex items-start gap-2.5 px-1 text-left text-sm text-slate-400"
                >
                    <Icon
                        name="apple"
                        class="mt-0.5 size-4 shrink-0 text-slate-500"
                    />
                    <span>{t.beta.iosNote}</span>
                </p>
            </div>

        </div>
    </section>

    {/* Deliberately quieter than the form card above: a plain outlined button,
        so the beta signup stays the loudest thing on the page. */}
    <section class="border-t border-white/10 bg-white/[0.02]">
        <div
            class="mx-auto flex w-full max-w-2xl flex-col items-center gap-3 px-6 py-16 text-center"
        >
            <h2 class="text-xl font-semibold tracking-tight text-white">
                {t.beta.webHeading}
            </h2>

            <p class="text-sm text-balance text-slate-400">{t.beta.webNotice}</p>

            <a
                href={WEB_APP_URL}
                class="mt-3 flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-white/25 hover:bg-white/10 hover:text-white"
            >
                <Icon name="monitor" class="size-4" />
                {t.beta.webCta}
            </a>

            <a
                href={getRelativeLocaleUrl(locale)}
                class="mt-6 text-sm text-slate-500 underline-offset-4 hover:text-white hover:underline"
            >
                ← {t.beta.backHome}
            </a>
        </div>
    </section>
</BaseLayout>
