                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "label_replace(sum(count_over_time((agent_session_cost_usd < 0.01)[$__range:])), \"bucket\", \"0-0.01\", \"\", \"\") or label_replace(sum(count_over_time((agent_session_cost_usd >= 0.01 and agent_session_cost_usd < 0.05)[$__range:])), \"bucket\", \"0.01-0.05\", \"\", \"\") or label_replace(sum(count_over_time((agent_session_cost_usd >= 0.05 and agent_session_cost_usd < 0.10)[$__range:])), \"bucket\", \"0.05-0.10\", \"\", \"\") or label_replace(sum(count_over_time((agent_session_cost_usd >= 0.10 and agent_session_cost_usd < 0.50)[$__range:])), \"bucket\", \"0.10-0.50\", \"\", \"\") or label_replace(sum(count_over_time((agent_session_cost_usd >= 0.50 and agent_session_cost_usd < 1.00)[$__range:])), \"bucket\", \"0.50-1.00\", \"\", \"\") or label_replace(sum(count_over_time((agent_session_cost_usd >= 1.00)[$__range:])), \"bucket\", \"1.00+\", \"\", \"\")",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "{{bucket}}",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "Token costs"
