                    "date": 3000,
                    "createdAt": 3000
                }
            ],
            "expected": { "adj": 260000 }
        },
        {
            "name": "an adjustment without a declared balance is a no-op",
            "entries": [
                {
                    "id": "salary",
                    "type": "income",
                    "accountId": "cash",
                    "amount": 40000,
                    "date": 1000,
                    "createdAt": 1000
                },
                {
                    "id": "legacy",
                    "type": "balance_adjustment",
                    "accountId": "cash",
                    "amount": 999,
                    "date": 2000,
                    "createdAt": 2000
                }
            ],
            "expected": { "legacy": 0 }
