                    "createdAt": 3000
                },
                {
                    "id": "buy-usd",
                    "type": "transfer",
                    "accountId": "ars",
                    "toAccountId": "usd",
                    "amount": 1500000,
                    "toAmount": 1000,
                    "date": 2000,
                    "createdAt": 2000
                }
            ],
            "expected": { "usd-adj": 9000 }
        },
        {
            "name": "other accounts' movements are ignored",
            "entries": [
                {
                    "id": "adj",
                    "type": "balance_adjustment",
                    "accountId": "cash",
                    "amount": 0,
                    "balanceAfter": 500000,
                    "date": 3000,
                    "createdAt": 3000
                },
                {
                    "id": "elsewhere",
