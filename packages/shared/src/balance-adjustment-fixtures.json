                    "amount": 70000,
                    "date": 2000,
                    "createdAt": 2000
                }
            ],
            "expected": { "adj": 500000 }
        },
        {
            "name": "an archived adjustment no longer pins the balance",
            "entries": [
                {
                    "id": "old",
                    "type": "balance_adjustment",
                    "accountId": "cash",
                    "amount": 100000,
                    "balanceAfter": 100000,
                    "date": 1000,
                    "createdAt": 1000,
