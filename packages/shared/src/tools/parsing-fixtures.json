{
    "$comment": "Cross-language parsing parity fixtures. Run by packages/shared/test/parsing-fixtures.test.ts (vitest, against src/tools/parsing.ts) AND by apps/native/test/voice/parsing_fixtures_test.dart (dart test, against lib/voice/tool_parsing.dart + lib/shared/money.dart). All date expectations are LOCAL wall-clock components so the fixtures are timezone-independent. Keep both runners in sync when adding cases.",
    "now": {
        "year": 2026,
        "month": 7,
        "day": 12,
        "hour": 14,
        "minute": 25,
        "second": 30,
        "millisecond": 0
    },
    "amountToCents": [
        { "input": 12.5, "cents": "1250" },
        { "input": -3.07, "cents": "-307" },
        { "input": 0, "cents": "0" },
        { "input": 0.30000000000000004, "cents": "30" },
        { "input": 1234.56, "cents": "123456" },
        { "input": 0.005, "cents": "1" },
        { "input": 1999999.99, "cents": "199999999" }
    ],
    "naturalDate": [
        {
            "input": "today",
            "expect": { "year": 2026, "month": 7, "day": 12 }
        },
        { "input": "hoy", "expect": { "year": 2026, "month": 7, "day": 12 } },
        {
            "input": "yesterday",
            "expect": { "year": 2026, "month": 7, "day": 11 }
        },
        { "input": "AYER", "expect": { "year": 2026, "month": 7, "day": 11 } },
        {
            "input": "anteayer",
            "expect": { "year": 2026, "month": 7, "day": 10 }
        },
        {
            "input": "day before yesterday",
            "expect": { "year": 2026, "month": 7, "day": 10 }
        },
        {
            "input": "tomorrow",
            "expect": { "year": 2026, "month": 7, "day": 13 }
        },
        {
            "input": "mañana",
            "expect": { "year": 2026, "month": 7, "day": 13 }
        },
        {
            "input": "manana",
            "expect": { "year": 2026, "month": 7, "day": 13 }
        },
        {
            "input": "hace 3 días",
            "expect": { "year": 2026, "month": 7, "day": 9 }
        },
        {
            "input": "hace 1 dia",
            "expect": { "year": 2026, "month": 7, "day": 11 }
        },
        {
            "input": "3 days ago",
            "expect": { "year": 2026, "month": 7, "day": 9 }
        },
        {
            "input": "el jueves pasado",
            "expect": { "year": 2026, "month": 7, "day": 9 }
        },
        {
            "input": "jueves pasado",
            "expect": { "year": 2026, "month": 7, "day": 9 }
        },
        {
            "input": "el pasado lunes",
            "expect": { "year": 2026, "month": 7, "day": 6 }
        },
        {
            "input": "last thursday",
            "expect": { "year": 2026, "month": 7, "day": 9 }
        },
        {
            "input": "el domingo pasado",
            "expect": { "year": 2026, "month": 7, "day": 5 },
            "$comment": "now is a Sunday: 'pasado' always means the previous occurrence, never today"
        },
        {
            "input": "2026-08-06",
            "expect": { "year": 2026, "month": 8, "day": 6 }
        },
        {
            "input": "2026-08-06T10:30:00",
            "expect": {
                "year": 2026,
                "month": 8,
                "day": 6,
                "hour": 10,
                "minute": 30
            }
        },
        { "input": "2026-02-30", "throws": true },
        { "input": "definitely not a date", "throws": true }
    ],
    "transactionDate": [
        {
            "timeStatus": "confirmed",
            "time": "17:00",
            "expect": {
                "year": 2026,
                "month": 7,
                "day": 12,
                "hour": 17,
                "minute": 0
            }
        },
        {
            "date": "el jueves pasado",
            "timeStatus": "confirmed",
            "time": "17:00",
            "expect": {
                "year": 2026,
                "month": 7,
                "day": 9,
                "hour": 17,
                "minute": 0
            }
        },
        {
            "date": "ayer",
            "timeStatus": "approximation",
            "time": "16:00",
            "expect": {
                "year": 2026,
                "month": 7,
                "day": 11,
                "hour": 16,
                "minute": 0
            }
        },
        {
            "date": "2026-08-06T00:00:00",
            "timeStatus": "confirmed",
            "expect": { "year": 2026, "month": 8, "day": 6 }
        },
        { "date": "2026-08-06", "timeStatus": "confirmed", "throws": true },
        { "date": "ayer", "timeStatus": "confirmed", "throws": true },
        { "date": "ayer", "timeStatus": "approximation", "throws": true },
        { "timeStatus": "confirmed", "time": "24:00", "throws": true },
        { "timeStatus": "confirmed", "time": "9:5", "throws": true },
        {
            "timeStatus": "none",
            "expect": {
                "year": 2026,
                "month": 7,
                "day": 12,
                "hour": 14,
                "minute": 25,
                "second": 30
            }
        },
        {
            "date": "ayer",
            "timeStatus": "none",
            "expect": {
                "year": 2026,
                "month": 7,
                "day": 11,
                "hour": 14,
                "minute": 25,
                "second": 30
            }
        }
    ]
}
